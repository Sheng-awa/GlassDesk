<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>..\..\src\GlassDesk.App\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="ReviewResources.xaml" />
    <ApplicationDefinition Include="ReviewResources.xaml" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="..\..\src\GlassDesk.App\GlassDesk.App.csproj" />
    <ProjectReference Include="..\..\src\GlassDesk.NativeBridge\GlassDesk.NativeBridge.csproj" />
    <ProjectReference Include="..\..\src\GlassDesk.Core\GlassDesk.Core.csproj" />
  </ItemGroup>
  <Target Name="PublishVisualReviewXamlResources"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="Prep_ComputeProcessXamlFiles"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="Visual review PRI is missing; build the tool before publishing." />
    <Error Condition="!Exists('$(OutputPath)ReviewResources.xbf')" Text="Visual review ReviewResources.xbf is missing." />
    <AssignTargetPath Files="@(GeneratedXamlDest)" RootFolder="$(OutputPath)">
      <Output TaskParameter="AssignedFiles" ItemName="_VisualReviewXamlPublishResources" />
    </AssignTargetPath>
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_VisualReviewXamlPublishResources)">
        <RelativePath>%(_VisualReviewXamlPublishResources.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="VerifyVisualReviewPublishedXaml" AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(PublishDir)$(ProjectPriFileName)')" Text="Visual review publish output is missing its PRI." />
    <Error Condition="!Exists('$(PublishDir)ReviewResources.xbf')" Text="Visual review publish output is missing ReviewResources.xbf." />
  </Target>
</Project>
