<Application
    x:Class="GlassDesk.App.ResidentApplication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- High contrast continues to use Windows' own palette. -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#28786E</Color>
                    <Color x:Key="SystemAccentColorDark1">#28786E</Color>
                    <Color x:Key="SystemAccentColorDark2">#20645C</Color>
                    <Color x:Key="SystemAccentColorDark3">#184F48</Color>
                    <Color x:Key="SystemAccentColorLight1">#478F85</Color>
                    <Color x:Key="SystemAccentColorLight2">#78ACA3</Color>
                    <Color x:Key="SystemAccentColorLight3">#B2D1CA</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
