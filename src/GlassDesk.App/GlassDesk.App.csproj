<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GlassDesk</AssemblyName>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefineConstants Condition="'$(GlassDeskUiPreview)'=='true'">$(DefineConstants);GLASSDESK_UI_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="..\GlassDesk.Core\GlassDesk.Core.csproj" />
    <ProjectReference Include="..\GlassDesk.NativeBridge\GlassDesk.NativeBridge.csproj" />
    <ProjectReference Include="..\GlassDesk.Platform\GlassDesk.Platform.csproj" />
    <ProjectReference Include="..\GlassDesk.Plugins\GlassDesk.Plugins.csproj" />
  </ItemGroup>
  <!-- Unpackaged MRT Core generates these resources but does not add them to
       dotnet publish. Keep the actual publish output complete, not only bin. -->
  <Target Name="PublishGlassDeskXamlResources"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="Prep_ComputeProcessXamlFiles"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The application PRI is missing: $(ProjectPriFullPath). Build the WinUI application before publishing." />
    <Error Condition="!Exists('$(OutputPath)App.xbf')" Text="The compiled application XAML is missing: $(OutputPath)App.xbf." />
    <AssignTargetPath Files="@(GeneratedXamlDest)" RootFolder="$(OutputPath)">
      <Output TaskParameter="AssignedFiles" ItemName="_GlassDeskXamlPublishResources" />
    </AssignTargetPath>
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_GlassDeskXamlPublishResources)">
        <RelativePath>%(_GlassDeskXamlPublishResources.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="VerifyGlassDeskPublishedXaml" AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(PublishDir)$(ProjectPriFileName)')" Text="Publish output is incomplete: the application PRI was not copied." />
    <Error Condition="!Exists('$(PublishDir)App.xbf')" Text="Publish output is incomplete: App.xbf was not copied." />
  </Target>
</Project>
